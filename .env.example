# Environment Configuration Template for awas-client-app

# -------------------------------------------------------------
# MODE A: Production API Backend (Default)
# -------------------------------------------------------------
# VITE_API_BASE_URL=https://awas-user-seven.vercel.app/
# VITE_BACKEND_URL=https://awas-user-seven.vercel.app

# -------------------------------------------------------------
# MODE B: Full Local Development (Local NestJS on port 3000)
# Create a .env.local file with these values:
# -------------------------------------------------------------
# VITE_API_BASE_URL=/api
# VITE_BACKEND_URL=http://localhost:3000
